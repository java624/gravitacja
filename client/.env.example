# ============================================================
#  Gravitacja - klient (frontend, port 5173)
#  Skopiuj do .env i uzupełnij WŁASNYMI wartościami z Supabase:
#  Dashboard -> Project Settings -> API
#  Uwaga: Vite czyta zmienne tylko przy starcie - po zmianie .env
#  zatrzymaj i uruchom ponownie `npm run dev`.
# ============================================================

# Supabase (te SAME wartości muszą być w admin/.env!)
VITE_SUPABASE_URL=https://TWOJ-PROJEKT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJI...anon...key

# Backend NestJS (płatności Stripe) - przez proxy Vite można zostawić puste
VITE_API_URL=http://localhost:3000
